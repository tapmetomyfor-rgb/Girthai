TabSettings:CreateToggle({
   Name = "🛡️ กันโดนเตะ (Anti-Kick)",
   CurrentValue = false,
   Callback = function(v)
      PlayClickSound()
      AntiKickEnabled = v
      if v then
          local rawMetatable = getrawmetatable or debug.getmetatable
          local setReadOnly = setreadonly or make_writeable
          if rawMetatable and setReadOnly then
              local gmt = rawMetatable(game)
              local oldNamecall = gmt.__namecall
              setReadOnly(gmt, false)
              gmt.__namecall = newcclosure(function(self, ...)
                  if AntiKickEnabled and string.lower(getnamecallmethod()) == "kick" then return nil end
                  return oldNamecall(self, ...)
              end)
              setReadOnly(gmt, true)
          end
      end
   end,
})

TabSettings:CreateToggle({
   Name = "🥔 ภาพดินน้ำมัน (Potato Graphics)",
   CurrentValue = false,
   Callback = function(v)
      PlayClickSound()
      PotatoEnabled = v
      if v then
          for _, p in pairs(workspace:GetDescendants()) do
              if p:IsA("BasePart") then
                  if not OriginalMaterials[p] then OriginalMaterials[p] = p.Material end
                  p.Material = Enum.Material.SmoothPlastic
              end
          end
      else
          for part, mat in pairs(OriginalMaterials) do if part and part.Parent then part.Material = mat end end
          OriginalMaterials = {}
      end
   end,
})

