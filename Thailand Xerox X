-- [ 2. ระบบหมวดหมู่ Tabs ]
----------------------------------------------------------------
local Pages = {}
local TabButtons = {}

local function CreateTab(tabName, order)
    local Page = Instance.new("ScrollingFrame", PageContainer)
    Page.Name = tabName .. "Page"
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.BackgroundTransparency = 1
    Page.BorderSizePixel = 0
    Page.ScrollBarThickness = 3
    Page.Visible = (order == 1)
    
    local UIList = Instance.new("UIListLayout", Page)
    UIList.SortOrder = Enum.SortOrder.LayoutOrder
    UIList.Padding = UDim.new(0, 8)
    
    Pages[tabName] = Page

    local TabBtn = Instance.new("TextButton", Sidebar)
    TabBtn.Size = UDim2.new(1, -10, 0, 35)
    TabBtn.Position = UDim2.new(0, 5, 0, (order - 1) * 40 + 5)
    TabBtn.BackgroundColor3 = (order == 1) and Color3.fromRGB(35, 35, 45) or Color3.fromRGB(22, 22, 28)
    TabBtn.Text = tabName
    TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    TabBtn.Font = Enum.Font.SourceSans
    TabBtn.TextSize = 14
    Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)

    TabBtn.MouseButton1Click:Connect(function()
        for name, p in pairs(Pages) do p.Visible = (name == tabName) end
        for _, b in pairs(TabButtons) do b.BackgroundColor3 = Color3.fromRGB(22, 22, 28) end
        TabBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    end)

    table.insert(TabButtons, TabBtn)
    return Page
end

local Tab1 = CreateTab("Menu Xerox", 1)
local Tab2 = CreateTab("PVP Xerox VP", 2)
local Tab3 = CreateTab("Setting Xerox", 3)

