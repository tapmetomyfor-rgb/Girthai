local function RemoveTargetWalls()
    for _, v in pairs(workspace:GetDescendants()) do
        if v.Name == "WallL" or v.Name == "WallR" then
            v:Destroy()
        end
    end
end

CreateToggle(TabFarm, "DeleteWalls", false, function(v)
    DeleteWallsEnabled = v
    if v then RemoveTargetWalls() end
end)

local function RemoveBrainrotBarriers()
    for _, v in pairs(workspace:GetDescendants()) do
        local nameLower = string.lower(v.Name)
        if nameLower:find("barrier") or nameLower:find("door") or nameLower == "wall" or v.Name == "DeliveryHitbox" then
            if v:IsA("BasePart") then
                v.CanCollide = false
                v.Transparency = 1
            elseif v:IsA("Model") then
                v:Destroy()
            end
        end
    end
end

CreateToggle(TabFarm, "DeleteBrainrotBarrier", false, function(v)
    DeleteBrainrotBarrierEnabled = v
    if v then RemoveBrainrotBarriers() end
end)

task.spawn(function()
    while true do
        task.wait(0.3)
        if DeleteWallsEnabled then RemoveTargetWalls() end
        if DeleteBrainrotBarrierEnabled then RemoveBrainrotBarriers() end
    end
end)

