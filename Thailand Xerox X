local TabSettings = Window:Tab({Title = "Setting Xerox ⚙️", Icon = "rbxassetid://6031280882"}) do
    TabSettings:Section({Title = "การป้องกัน & กราฟิก"})

    TabSettings:Toggle({
        Title = "🛡️ กันโดนเตะ / กันแบน (Anti-Kick)",
        Value = false,
        Callback = function(v)
            AntiKickEnabled = v
            if v then
                local rawMetatable = getrawmetatable or debug.getmetatable
                local setReadOnly = setreadonly or make_writeable
                if rawMetatable and setReadOnly then
                    local gmt = rawMetatable(game)
                    local oldNamecall = gmt.__namecall
                    setReadOnly(gmt, false)

                    gmt.__namecall = newcclosure(function(self, ...)
                        local method = getnamecallmethod()
                        if AntiKickEnabled and string.lower(method) == "kick" then
                            return nil
                        end
                        return oldNamecall(self, ...)
                    end)
                    setReadOnly(gmt, true)
                end
            end
        end
    })

    TabSettings:Toggle({
        Title = "🥔 ภาพดินน้ำมัน (Potato Graphics)",
        Desc = "ช่วยลดอาการแลค ปรับทุกอย่างเป็น SmoothPlastic",
        Value = false,
        Callback = function(v)
            PotatoEnabled = v
            if v then
                for _, p in pairs(workspace:GetDescendants()) do
                    if p:IsA("BasePart") then
                        if not OriginalMaterials[p] then OriginalMaterials[p] = p.Material end
                        p.Material = Enum.Material.SmoothPlastic
                    end
                end
            else
                for part, mat in pairs(OriginalMaterials) do
                    if part and part.Parent then part.Material = mat end
                end
                OriginalMaterials = {}
            end
        end
    })

    TabSettings:Toggle({
        Title = "💡 เพิ่มแสงสว่าง (FullBright)",
        Desc = "มองเห็นในที่มืดได้ชัดเจน",
        Value = false,
        Callback = function(v)
            FullBrightEnabled = v
            Lighting.Brightness = v and 2 or 1
            Lighting.GlobalShadows = not v
        end
    })

    TabSettings:Button({
        Title = "🧱 ลบกำแพงแมพออก (Delete Walls)",
        Callback = function()
            for _, p in pairs(workspace:GetDescendants()) do
