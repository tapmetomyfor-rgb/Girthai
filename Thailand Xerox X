PlayBoomboxBtn.MouseButton1Click:Connect(function()
    local id = tonumber(SoundIdBox.Text)
    if not id then return end
    
    -- ค้นหา Boombox ในกระเป๋าตัวละครเพื่อยิง Remote
    local tool = Character:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
    local playedOnServer = false
    
    if tool then
        for _, obj in pairs(tool:GetDescendants()) do
            if obj:IsA("RemoteEvent") then
                pcall(function() obj:FireServer(id) end)
                pcall(function() obj:FireServer("PlaySong", id) end)
                playedOnServer = true
            end
        end
    end
    
    -- หากในตัวไม่มี Boombox ของเกม ให้สร้างเสียง Client-side สำรอง
    if not playedOnServer and Character and Character:FindFirstChild("HumanoidRootPart") then
        local sound = Character.HumanoidRootPart:FindFirstChild("LocalBoomboxSound")
        if not sound then
            sound = Instance.new("Sound", Character.HumanoidRootPart)
            sound.Name = "LocalBoomboxSound"
        end
        sound.SoundId = "rbxassetid://" .. tostring(id)
        sound.Volume = 2
        sound:Play()
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if Character and Character:FindFirstChild("Humanoid") then
        local hum = Character.Humanoid
        hum.WalkSpeed = 16 + (SpeedLevel - 1) * 12
        hum.UseJumpPower = true
        hum.JumpPower = 50 + (JumpLevel - 1) * 20
        hum.JumpHeight = 7.2 + (JumpLevel - 1) * 5
    end

    if NoclipEnabled and Character then
        for _, p in pairs(Character:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end

    if FlyEnabled and Character and Character:FindFirstChild("HumanoidRootPart") then
        local hrp = Character.HumanoidRootPart
        local flySpeed = FlySpeedLevel * 35
        local moveDir = Vector3.new()

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end

        if moveDir.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (moveDir.Unit * flySpeed * dt)
        end
        hrp.Velocity = Vector3.new(0,0,0)
    end
end)

