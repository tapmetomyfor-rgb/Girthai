local function GetMurdererPlayer()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local backpack = plr:FindFirstChild("Backpack")
            local hasKnife = char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife"))
            if hasKnife then return plr end
        end
    end
    return nil
end

local function GetSheriffPlayer()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local backpack = plr:FindFirstChild("Backpack")
            local hasGun = char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") or (backpack and (backpack:FindFirstChild("Gun") or backpack:FindFirstChild("Revolver")))
            if hasGun then return plr end
        end
    end
    return nil
end

local function GetMurderRole(plr)
    if not plr or not plr.Character then return "Innocent" end
    local char = plr.Character
    local backpack = plr:FindFirstChild("Backpack")
    
    local hasKnife = char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife"))
    local hasGun = char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") or (backpack and (backpack:FindFirstChild("Gun") or backpack:FindFirstChild("Revolver")))
    
    if hasKnife then return "Murderer" end
    if hasGun then return "Sheriff" end
    return "Innocent"
end

local function ShootMurdererCurve()
    local murderer = GetMurdererPlayer()
    if not murderer or not murderer.Character then return end
    
    local targetBody = murderer.Character:FindFirstChild("HumanoidRootPart") or murderer.Character:FindFirstChild("UpperTorso")
    if not targetBody then return end
    
    local gun = Character:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Gun")
    
    if gun then
        if gun.Parent == LocalPlayer.Backpack then
            Character.Humanoid:EquipTool(gun)
            task.wait(0.05)
        end
        
        local shootRemote = gun:FindFirstChild("Shoot") or gun:FindFirstChild("KnifeServer") or game:GetService("ReplicatedStorage"):FindFirstChild("Shoot", true)
        
        if shootRemote and shootRemote:IsA("RemoteEvent") then
            shootRemote:FireServer(targetBody.CFrame, targetBody.Position)
        else
            local oldCam = Camera.CFrame
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetBody.Position)
            if mouse1click then mouse1click() else gun:Activate() end
            task.wait(0.02)
            Camera.CFrame = oldCam
        end
    end
end

