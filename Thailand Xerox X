-- [ Engine: ระบบดีดคน (Push Fling) ]
----------------------------------------------------------------
local isFlinging = false

local function FlingTarget(targetPlayer)
    if isFlinging or not targetPlayer or not targetPlayer.Character then return end
    
    local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    
    if not targetHRP or not myHRP then return end
    
    isFlinging = true
    local oldCFrame = myHRP.CFrame
    
    local bV = Instance.new("BodyVelocity")
    bV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bV.Velocity = Vector3.new(999999, 999999, 999999)
    bV.Parent = myHRP

    local bAV = Instance.new("BodyAngularVelocity")
    bAV.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bAV.AngularVelocity = Vector3.new(999999, 999999, 999999)
    bAV.Parent = myHRP

    local startTime = tick()
    local flingConnection
    
    flingConnection = RunService.Heartbeat:Connect(function()
        if not isFlinging or (tick() - startTime > 1.5) or not targetPlayer.Character or not targetHRP.Parent then
            flingConnection:Disconnect()
            if bV then bV:Destroy() end
            if bAV then bAV:Destroy() end
            
            myHRP.Velocity = Vector3.new(0, 0, 0)
            myHRP.RotVelocity = Vector3.new(0, 0, 0)
            myHRP.CFrame = oldCFrame
            isFlinging = false
            return
        end
        
        myHRP.Velocity = Vector3.new(0, 9999, 0)
        myHRP.RotVelocity = Vector3.new(99999, 99999, 99999)
        myHRP.CFrame = targetHRP.CFrame * CFrame.new(math.random(-1,1), math.random(-1,1), math.random(-1,1))
    end)
end

----------------------------------------------------------------
-- [ Engine: ระบบหาฆาตกรและตำรวจ ]
----------------------------------------------------------------
local function GetMurdererPlayer()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local backpack = plr:FindFirstChild("Backpack")
            local hasKnife = char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife"))
            if hasKnife then return plr end
        end
    end
    return nil
end

local function GetSheriffPlayer()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local backpack = plr:FindFirstChild("Backpack")
            local hasGun = char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") or (backpack and (backpack:FindFirstChild("Gun") or backpack:FindFirstChild("Revolver")))
            if hasGun then return plr end
        end
    end
    return nil
end

local function GetMurderRole(plr)
    if not plr or not plr.Character then return "Innocent" end
    local char = plr.Character
    local backpack = plr:FindFirstChild("Backpack")
    
    local hasKnife = char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife"))
    local hasGun = char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") or (backpack and (backpack:FindFirstChild("Gun") or backpack:FindFirstChild("Revolver")))
    
    if hasKnife then return "Murderer" end
    if hasGun then return "Sheriff" end
    return "Innocent"
end

