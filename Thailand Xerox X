RunService.RenderStepped:Connect(function()
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    
    if myHum then
        if WalkSpeedValue > 16 then myHum.WalkSpeed = WalkSpeedValue end
        myHum.UseJumpPower = true
        if JumpPowerValue > 50 then myHum.JumpPower = JumpPowerValue end
    end
    
    if NoclipEnabled then
        for _, part in pairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
        end
    end

    -- ⚾ ระบบเบสบอลอัตโนมัติ (Auto Hit & Auto Skill)
    if AutoHitEnabled then
        local ball, dist = GetIncomingBaseball()
        if ball and dist <= HitDistanceThreshold then
            PerformHit()
        end
    end

    if AutoSkillEnabled then
        -- ใช้สกิลทุกๆ รอบลูปเมื่อเปิดใช้งาน (หรือใส่เงื่อนไขคูลดาวน์สกิลตามแมพ)
        task.spawn(function()
            pcall(function() TriggerAutoSkill() end)
        end)
    end

    if KillAuraPull and myHRP then
        local tool = myChar:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
        if tool and tool.Parent == LocalPlayer.Backpack then myHum:EquipTool(tool) end
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                p.Character.HumanoidRootPart.CFrame = myHRP.CFrame * CFrame.new(0, 0, -3.5)
            end
        end
        if tool then tool:Activate() end
    end

    if AutoFlingLoop and SelectedTarget and not isFlinging then
        FlingTarget(SelectedTarget)
    end

    -- [ ระบบ Aimbot ]
    if UniversalAimbotEnabled then
        local closest = GetClosestPlayer()
        if closest and closest.Character and closest.Character:FindFirstChild("HumanoidRootPart") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closest.Character.HumanoidRootPart.Position)
        end
    elseif AimMurdererEnabled then
        local m = GetMurdererPlayer()
        if m and m.Character and m.Character:FindFirstChild("HumanoidRootPart") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, m.Character.HumanoidRootPart.Position)
        end
    elseif AimSheriffEnabled then
        local s = GetSheriffPlayer()
        if s and s.Character and s.Character:FindFirstChild("HumanoidRootPart") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, s.Character.HumanoidRootPart.Position)
        end
    end

    -- [ ระบบ ESP ]
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local highlight = char:FindFirstChild("XVP_Highlight")

            if MurderESPEnabled then
                if not highlight then
                    highlight = Instance.new("Highlight", char)
                    highlight.Name = "XVP_Highlight"
                end
                
                local role = GetMurderRole(plr)
                if role == "Murderer" then highlight.FillColor = Color3.fromRGB(255, 0, 0)
                elseif role == "Sheriff" then highlight.FillColor = Color3.fromRGB(0, 150, 255)
                else highlight.FillColor = Color3.fromRGB(0, 255, 120) end

                highlight.Enabled = true
            else
                if highlight then highlight.Enabled = false end
            end
        end
    end

    local droppedGun = GetDroppedGun()
    if droppedGun then
        local gunHighlight = droppedGun:FindFirstChild("XVP_GunHighlight")
        if GunESPEnabled then
            if not gunHighlight then
                gunHighlight = Instance.new("Highlight", droppedGun)
                gunHighlight.Name = "XVP_GunHighlight"
                gunHighlight.FillColor = Color3.fromRGB(255, 215, 0)
                gunHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            end
            gunHighlight.Enabled = true
        else
            if gunHighlight then gunHighlight.Enabled = false end
        end
    end
end)

