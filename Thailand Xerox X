    -- Noclip
    if NoclipEnabled and Character then
        for _, p in pairs(Character:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end

    -- Murder ESP
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local highlight = char:FindFirstChild("ThailandXVP_Highlight")

            if MurderESPEnabled or ESPEnabled then
                if not highlight then
                    highlight = Instance.new("Highlight", char)
                    highlight.Name = "ThailandXVP_Highlight"
                end
                
                local col = ESPColors[CurrentESPColorIdx]
                if MurderESPEnabled then
                    local role = GetMurderRole(plr)
                    if role == "Murderer" then col = Color3.fromRGB(255, 0, 0)
                    elseif role == "Sheriff" then col = Color3.fromRGB(0, 150, 255)
                    else col = Color3.fromRGB(0, 255, 120) end
                end

                highlight.FillColor = col
                highlight.Enabled = true
            else
                if highlight then highlight.Enabled = false end
            end
        end
    end

    -- Aim Lock on Murderer
    if AimLockMurderEnabled then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and GetMurderRole(plr) == "Murderer" and plr.Character and plr.Character:FindFirstChild("Head") then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, plr.Character.Head.Position)
                break
            end
        end
    end
end)

