local AntiKickEnabled = false
local OldNamecall = nil

local function EnableAntiKick()
    if OldNamecall then return end
    
    local rawMetatable = getrawmetatable or debug.getmetatable
    local setReadOnly = setreadonly or make_writeable
    
    if rawMetatable and setReadOnly then
        local gmt = rawMetatable(game)
        OldNamecall = gmt.__namecall
        setReadOnly(gmt, false)

        gmt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if AntiKickEnabled and string.lower(method) == "kick" then
                warn("[Thailand XVP] Blocked a kick/ban attempt!")
                return nil
            end
            return OldNamecall(self, ...)
        end)
        setReadOnly(gmt, true)
    end

    local oldKick
    oldKick = hookfunction(LocalPlayer.Kick, newcclosure(function(self, ...)
        if AntiKickEnabled then
            warn("[Thailand XVP] Prevented LocalPlayer:Kick()")
            return nil
        end
        return oldKick(self, ...)
    end))
end

