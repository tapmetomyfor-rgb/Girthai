RunService.RenderStepped:Connect(function()
    if Character and Character:FindFirstChild("Humanoid") then
        local hum = Character.Humanoid
        hum.WalkSpeed = 16 + (SpeedLevel - 1) * 12
        hum.UseJumpPower = true
        hum.JumpPower = 50 + (JumpLevel - 1) * 20
    end

    if NoclipEnabled and Character then
        for _, p in pairs(Character:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local highlight = char:FindFirstChild("ThailandXVP_Highlight")

            if MurderESPEnabled or ESPEnabled then
                if not highlight then
                    highlight = Instance.new("Highlight", char)
                    highlight.Name = "ThailandXVP_Highlight"
                end
                
                local col = Color3.fromRGB(0, 255, 120)
                if MurderESPEnabled then
                    local role = GetMurderRole(plr)
                    if role == "Murderer" then col = Color3.fromRGB(255, 0, 0)
                    elseif role == "Sheriff" then col = Color3.fromRGB(0, 150, 255) end
                end

                highlight.FillColor = col
                highlight.Enabled = true
            else
                if highlight then highlight.Enabled = false end
            end
        end
    end

    if AimLockMurderEnabled then
        local m = GetMurdererPlayer()
        if m and m.Character then
            local bodyPart = m.Character:FindFirstChild("HumanoidRootPart") or m.Character:FindFirstChild("UpperTorso")
            if bodyPart then
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, bodyPart.Position), 0.25)
            end
        end
    end
end)

