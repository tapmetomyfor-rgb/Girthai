    end
})

-- Section 2: Target Selector
local SecTarget = TabPull:Section("เลือกเป้าหมาย")

local TargetNames = {}
local TargetDropdown = SecTarget:Dropdown({
    Name = "เลือกชื่อผู้เล่น:",
    Items = TargetNames,
    Callback = function(v)
        SelectedTarget = Players:FindFirstChild(v)
    end
})

local function RefreshList()
    TargetNames = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(TargetNames, p.Name)
        end
    end
    TargetDropdown:Set(TargetNames)
end

SecTarget:Button({
    Name = "🔄 อัปเดตรายชื่อคนในแมพ",
    Callback = function()
        RefreshList()
    end
})

