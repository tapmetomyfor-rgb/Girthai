TabSettings:CreateDropdown({
   Name = L[CurrentLang].SelectLang,
   Options = {"ไทย (Thai)", "English"},
   CurrentOption = "ไทย (Thai)",
   Callback = function(Option)
      PlayClickSound()
      if type(Option) == "table" then Option = Option[1] end
      if Option == "English" then UpdateLanguage("EN") else UpdateLanguage("TH") end
   end,
})

local SecGraphics = TabSettings:CreateSection(L[CurrentLang].SecGraphics)

local TogAntiKick = TabSettings:CreateToggle({
   Name = L[CurrentLang].AntiKick,
   CurrentValue = false,
   Callback = function(v)
      PlayClickSound()
      AntiKickEnabled = v
      if v then
          pcall(function()
              local rawMetatable = getrawmetatable or debug.getmetatable
              local setReadOnly = setreadonly or make_writeable
              if rawMetatable and setReadOnly then
                  local gmt = rawMetatable(game)
                  local oldNamecall = gmt.__namecall
                  setReadOnly(gmt, false)
                  gmt.__namecall = newcclosure(function(self, ...)
                      if AntiKickEnabled and string.lower(getnamecallmethod()) == "kick" then return nil end
                      return oldNamecall(self, ...)
                  end)
                  setReadOnly(gmt, true)
              end
          end)
      end
   end,
})

local TogPotato = TabSettings:CreateToggle({
   Name = L[CurrentLang].Potato,
   CurrentValue = false,
   Callback = function(v)
      PlayClickSound()
      PotatoEnabled = v
      if v then
          for _, p in pairs(workspace:GetDescendants()) do
              if p:IsA("BasePart") then
                  if not OriginalMaterials[p] then OriginalMaterials[p] = p.Material end
                  p.Material = Enum.Material.SmoothPlastic
              end
          end
      else
          for part, mat in pairs(OriginalMaterials) do if part and part.Parent then part.Material = mat end end
          OriginalMaterials = {}
      end
   end,
})

local TogFullBright = TabSettings:CreateToggle({
   Name = L[CurrentLang].FullBright,
   CurrentValue = false,
   Callback = function(v)
      PlayClickSound()
      FullBrightEnabled = v
      Lighting.Brightness = v and 2 or 1
      Lighting.GlobalShadows = not v
   end,
})

local BtnDeleteWalls = TabSettings:CreateButton({
   Name = L[CurrentLang].DeleteWalls,
   Callback = function(v)
      PlayClickSound()
      for _, p in pairs(workspace:GetDescendants()) do
          if p.Name == "WallL" or p.Name == "WallR" then p:Destroy() end
      end
   end,
})

