local function ParryBall()
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    task.wait(0.01)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)

    pcall(function()
        local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes") or game:GetService("ReplicatedStorage")
        if remotes:FindFirstChild("ParryButtonPress") then
            remotes.ParryButtonPress:FireServer()
        elseif remotes:FindFirstChild("Parry") then
            remotes.Parry:FireServer()
        end
    end)
end

RunService.PreRender:Connect(function()
    if not AutoParryEnabled then return end
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then return end

    local hrp = Character.HumanoidRootPart
    local ballsFolder = workspace:FindFirstChild("Balls") or workspace

    for _, obj in pairs(ballsFolder:GetChildren()) do
        if obj:IsA("BasePart") or obj.Name == "Ball" or obj:getAttribute("realBall") == true then
            local ball = obj
            local distance = (ball.Position - hrp.Position).Magnitude
            local velocity = ball.Velocity.Magnitude
            local parryDistance = math.clamp(velocity * 0.55, 15, 65)

            local isTargetingMe = false
            if ball:FindFirstChild("Target") and ball.Target.Value == LocalPlayer.Name then
                isTargetingMe = true
            elseif (ball.Position + ball.Velocity - hrp.Position).Magnitude < distance then
                isTargetingMe = true
            end

            if isTargetingMe and distance <= parryDistance then
                ParryBall()
                break
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    local nearestPlr = nil
    local shortestDist = 60

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local highlight = char:FindFirstChild("ThailandXVP_Highlight")
            local bbGui = char:FindFirstChild("ThailandXVP_NameTag")

            if ESPEnabled then
                if not highlight then
                    highlight = Instance.new("Highlight", char)
                    highlight.Name = "ThailandXVP_Highlight"
                end
                highlight.FillColor = ESPColors[CurrentESPColorIdx]
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.3
                highlight.OutlineTransparency = 0
                highlight.Enabled = true

                if not bbGui and char:FindFirstChild("Head") then
                    bbGui = Instance.new("BillboardGui", char)
                    bbGui.Name = "ThailandXVP_NameTag"
                    bbGui.Adornee = char.Head
                    bbGui.Size = UDim2.new(0, 100, 0, 30)
                    bbGui.StudsOffset = Vector3.new(0, 2.5, 0)
                    bbGui.AlwaysOnTop = true

                    local txt = Instance.new("TextLabel", bbGui)
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.Text = plr.DisplayName
                    txt.Font = Enum.Font.GothamBold
                    txt.TextSize = 13
                    txt.TextStrokeTransparency = 0
                end
                if bbGui and bbGui:FindFirstChildOfClass("TextLabel") then
                    bbGui:FindFirstChildOfClass("TextLabel").TextColor3 = ESPColors[CurrentESPColorIdx]
                    bbGui.Enabled = true
                end
            else
                if highlight then highlight.Enabled = false end
                if bbGui then bbGui.Enabled = false end
            end

            if AimbotEnabled and char:FindFirstChild("Head") then
                local screenPos, onScreen = Camera:WorldToViewportPoint(char.Head.Position)
                if onScreen then
                    local centerScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - centerScreen).Magnitude
                    
                    if distFromCenter < shortestDist then
                        shortestDist = distFromCenter
                        nearestPlr = plr
                    end
                end
            end
        end
    end

    if AimbotEnabled and nearestPlr and nearestPlr.Character and nearestPlr.Character:FindFirstChild("Head") then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, nearestPlr.Character.Head.Position)
    end
end)

