-- ค้นหาลูกบอลในเกมเบสบอล (มักจะอยู่ใน Workspace หรือ Folder เฉพาะ)
local function GetIncomingBaseball()
    for _, obj in pairs(workspace:GetDescendants()) do
        if (string.lower(obj.Name):find("ball") or string.lower(obj.Name):find("baseball") or string.lower(obj.Name):find("pitch")) and obj:IsA("BasePart") then
            local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myHRP then
                local dist = (obj.Position - myHRP.Position).Magnitude
                -- ตรวจสอบว่าลูกบอลพุ่งเข้ามาใกล้ตัวในระยะที่กำหนด
                if dist <= 40 then
                    return obj, dist
                end
            end
        end
    end
    return nil, 999
end

-- จำลองการคลิกตีบอล (Batting Action)
local function PerformHit()
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if tool then
        tool:Activate()
    else
        -- ถ้าไม่ได้ถือเครื่องมือ ให้จำลองการกดคลิกซ้ายผ่าน VirtualUser หรือกดปุ่มตี
        VirtualUser:Button1Down(Vector2.new(0,0), Camera.CFrame)
        task.wait(0.05)
        VirtualUser:Button1Up(Vector2.new(0,0), Camera.CFrame)
    end
end

-- จำลองการกดใช้สกิล (เช่น ปุ่ม E หรือปุ่มคีย์ลัดสกิลในเกม)
