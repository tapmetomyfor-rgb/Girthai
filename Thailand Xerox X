local SendWebhookBtn = Instance.new("TextButton", WebhookFrame)
SendWebhookBtn.Size = UDim2.new(1, -20, 0, 30)
SendWebhookBtn.Position = UDim2.new(0, 10, 0, 46)
SendWebhookBtn.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
SendWebhookBtn.Text = LanguageData[CurrentLanguage]["SendWebhook"]
SendWebhookBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
SendWebhookBtn.Font = Enum.Font.SourceSansBold
SendWebhookBtn.TextSize = 13
Instance.new("UICorner", SendWebhookBtn).CornerRadius = UDim.new(0, 4)

SendWebhookBtn.MouseButton1Click:Connect(function()
    local url = WebhookInput.Text
    if url ~= "" and (string.find(url, "discord.com/api/webhooks") or string.find(url, "discordapp.com/api/webhooks")) then
        local data = {
            ["content"] = "🚀 **Thailand XVP Loaded!**",
            ["embeds"] = {{
                ["title"] = "สคริปต์ Thailand XVP ถูกเปิดใช้งานแล้ว",
                ["description"] = "ผู้เล่น: **" .. LocalPlayer.Name .. "** (" .. LocalPlayer.DisplayName .. ")\nGame ID: " .. game.PlaceId,
                ["color"] = 16711730
            }}
        }
        local json = HttpService:JSONEncode(data)
        local requestFunc = syn and syn.request or http and http.request or request or http_request
        if requestFunc then
            requestFunc({
                Url = url,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = json
            })
            SendWebhookBtn.Text = "✅ ส่งข้อมูลเรียบร้อย!"
            task.wait(2)
            SendWebhookBtn.Text = LanguageData[CurrentLanguage]["SendWebhook"]
        end
    end
end)

